{
  "name": "qa-playground-api",
  "version": "0.1.0",
  "description": "Self-hosted REST API playground for QA engineers, test automation, database testing, and performance engineering.",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --env-file=.env.test --test",
    "test:docker": "node --test",
    "db:migrate": "node scripts/migrate.js",
    "db:migrate:test": "node --env-file=.env.test scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:seed:test": "node --env-file=.env.test scripts/seed.js",
    "data:generate:small": "node scripts/generate-performance-data.js small",
    "data:generate:medium": "node scripts/generate-performance-data.js medium",
    "data:generate:large": "node scripts/generate-performance-data.js large",
    "data:link": "node scripts/link-performance-datasets.js",
    "data:reset": "node scripts/reset-performance-data.js"
  },
  "keywords": [
    "qa",
    "api-testing",
    "test-automation",
    "performance-testing",
    "performance-engineering",
    "postgresql",
    "docker",
    "rest-api",
    "qa-playground"
  ],
  "author": "Danijel Popović",
  "license": "MIT",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dpopovic1990/qa-playground-api.git"
  },
  "bugs": {
    "url": "https://github.com/dpopovic1990/qa-playground-api/issues"
  },
  "homepage": "https://github.com/dpopovic1990/qa-playground-api#readme",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "supertest": "^7.3.2"
  }
}